spring.application.name=ImportEase

# ==========================================================
# DATABASE CONFIGURATION (NEON)
# Get connection details from Neon dashboard: https://neon.tech
# ==========================================================
spring.datasource.url=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
spring.datasource.username=YOUR_NEON_USERNAME
spring.datasource.password=YOUR_NEON_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# ==========================================================
# HIBERNATE / JPA SETTINGS
# ==========================================================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# ==========================================================
# BREVO API (For OTP via SMS and Email)
# Get your API key from: https://app.brevo.com → SMTP & API → API Keys
# ==========================================================
brevo.api.key=YOUR_BREVO_API_KEY
brevo.sms.sender=ImportEase
brevo.email.sender.name=ImportEase
brevo.email.sender.email=noreply@importease.com